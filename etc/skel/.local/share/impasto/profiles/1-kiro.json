{
  "impasto": 1,
  "name": "Kiro",
  "wallpaper": "~/.config/kiro-hyprland-impasto/bg/kiro.jpg",
  "palette": "adaptive",
  "settings": {
    "barStyle": "island",
    "islandAttached": true,
    "barLeft": [
      "workspaces",
      "launcher"
    ],
    "barRight": [
      "notifications",
      "network",
      "volume",
      "battery"
    ],
    "chipShape": "icon",
    "chipFigure": "off",
    "clockShowsDate": true,
    "desktopTheme": "analogue",
    "desktopOpacity": 60,
    "desktopWidgets": [
      {
        "id": "clock",
        "family": "4x4",
        "col": 0,
        "row": 0,
        "key": "clock-0-0"
      },
      {
        "id": "weather",
        "family": "4x2",
        "col": 0,
        "row": 4,
        "key": "weather-0-4"
      },
      {
        "id": "calendar",
        "family": "2x2",
        "col": 0,
        "row": 6,
        "key": "calendar-0-6"
      },
      {
        "id": "battery",
        "family": "2x2",
        "col": 2,
        "row": 6,
        "key": "battery-2-6"
      },
      {
        "id": "volume",
        "family": "2x2",
        "col": 15,
        "row": 0,
        "key": "volume-15-0"
      },
      {
        "id": "brightness",
        "family": "2x2",
        "col": 15,
        "row": 2,
        "key": "brightness-15-2"
      },
      {
        "id": "timer",
        "family": "2x2",
        "col": 15,
        "row": 4,
        "key": "timer-15-4"
      },
      {
        "id": "media",
        "family": "2x2",
        "col": 15,
        "row": 6,
        "key": "media-15-6"
      }
    ],
    "dockEdge": "bottom",
    "dockAutohide": true,
    "dockPinned": [
      "Alacritty.desktop",
      "thunar.desktop",
      "firefox.desktop"
    ],
    "greeting": "lava",
    "wallpaperTransition": "fade",
    "keys": {
      "Applications · Open a terminal": "SUPER + Return",
      "Applications · Open the file manager": "SUPER + SHIFT + Return",
      "Applications · Open the browser": "SUPER + B",
      "Windows · Close the focused window": "SUPER + Q",
